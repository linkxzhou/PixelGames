{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pxl/art-spec/v3",
  "title": "spec-manifest.json",
  "type": "object",
  "required": ["schema_version", "scope", "palette", "visual_intent", "visual_plan", "assets", "capability_digest"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 3 }, "scope": { "enum": ["all", "slice"] },
    "palette": { "type": ["string", "null"] }, "capability_digest": { "type": "string" },
    "visual_intent": { "$ref": "#/definitions/dependency" },
    "visual_plan": { "$ref": "#/definitions/dependency" },
    "design_digest": { "type": "string" }, "assets": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dependency": { "type": "object", "required": ["path", "digest"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/definitions/digest" } } },
    "entry": {
      "type": "object",
      "required": ["id", "kind", "strategy", "size_px", "spec", "recipe", "anims", "status", "digests", "dependencies", "requirement_digest", "warnings"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["sprite", "tile", "ui", "effect", "overlay"] },
        "strategy": { "enum": ["shapes", "ascii", "svg", "parts", "template", "tile_gen", "external"] },
        "size_px": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
        "spec": { "type": "string" }, "recipe": { "type": "string" },
        "anims": { "type": "array", "items": { "type": "object" } },
        "status": { "enum": ["ok", "missing", "invalid"] },
        "digests": { "type": "object", "additionalProperties": { "$ref": "#/definitions/digest" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/definitions/dependency" } },
        "requirement_digest": { "$ref": "#/definitions/digest" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
