{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pxl/brief/v1",
  "title": "brief.json",
  "description": "The only hand-written input, consumed by `step-100 init`. `notes` is preserved verbatim through the whole pipeline (after game-creator progress.md).",
  "type": "object",
  "required": ["schema_version", "game_id", "genre"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "genre": {
      "type": "string",
      "description": "Must name a template under steps/step-100-design/templates/."
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "scale": { "type": "integer", "minimum": 1 }
      }
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": ["16", "32", "64", "128", "256"],
          "description": "Native size tier (pxl SizeProfile)."
        },
        "palette": { "type": "string" }
      }
    },
    "slice": {
      "type": "object",
      "required": ["assets", "levels"],
      "additionalProperties": false,
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "levels": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_assets": { "type": "integer", "minimum": 1 },
        "max_model_turns": { "type": "integer", "minimum": 1 }
      }
    },
    "notes": {
      "type": "string",
      "description": "The human's original words, kept verbatim, never summarised."
    }
  }
}
