{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pxl/asset-instance/v1",
  "title": "asset-instance.json",
  "description": "A frozen choice from the prototype library: which prototype, which parameters, which surfaces, which seed. Step 200 writes it; step 300 expands it deterministically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "instance_id", "prototype", "size_tier", "params", "surfaces", "seed", "patches"],
  "properties": {
    "contract": { "const": "asset-instance/v1" },
    "instance_id": { "$ref": "#/definitions/id" },
    "prototype": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "size_tier": { "$ref": "#/definitions/id" },
    "params": {
      "type": "object",
      "additionalProperties": { "type": ["boolean", "integer", "string"] }
    },
    "surfaces": {
      "type": "object",
      "description": "region id -> surface recipe id",
      "additionalProperties": { "$ref": "#/definitions/id" }
    },
    "seed": { "type": "integer", "minimum": 0 },
    "patches": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["region", "rows"],
        "properties": {
          "region": { "$ref": "#/definitions/id" },
          "rows": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
