{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pxl/module/v1",
  "title": "module.json",
  "description": "A metatile: a layout in tile cells that may nest other modules, carry pixel-anchored decorations (optionally scene-kit references) and independent collision cells. Decoration and collision are separate lists; changing one never changes the other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "version",
    "size",
    "tiles",
    "modules",
    "decor",
    "collision",
    "license",
    "review"
  ],
  "properties": {    "contract": {
      "const": "module/v1"
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Module size in tile cells."
    },
    "terrain": {
      "type": "array",
      "description": "Terrain layers resolved through 47-mask coverage at compile time. Each cell's mask is computed from same-layer neighbours; a coverage gap is an error, never a default tile.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tileset",
          "cells"
        ],
        "properties": {
          "tileset": {
            "$ref": "#/definitions/id"
          },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/cell"
            }
          }
        }
      }
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tileset",
          "tile",
          "at"
        ],
        "properties": {
          "tileset": {
            "$ref": "#/definitions/id"
          },
          "tile": {
            "$ref": "#/definitions/id"
          },
          "at": {
            "$ref": "#/definitions/cell"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "at"
        ],
        "properties": {
          "module": {
            "$ref": "#/definitions/id"
          },
          "at": {
            "$ref": "#/definitions/cell"
          },
          "variant": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "decor": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at",
          "layer"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "at": {
            "$ref": "#/definitions/point"
          },
          "resource_id": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "scene_kit": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "layer": {
            "enum": [
              "back",
              "front"
            ]
          }
        }
      }
    },
    "collision": {
      "type": "array",
      "description": "Independent collision cells in tile-cell coordinates.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "kind"
        ],
        "properties": {
          "at": {
            "$ref": "#/definitions/cell"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Set by a human reviewer only."
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
